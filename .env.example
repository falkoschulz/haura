# Optional: Home Assistant default configuration
VITE_HA_URL="http://192.168.0.5:8123"
VITE_HA_TOKEN="your_long_lived_access_token_here"
VITE_HA_ENTITY_BATTERY_SOC="sensor.foxess_bat_soc"
VITE_HA_ENTITY_SOLAR_TODAY="sensor.foxess_solar_today"
VITE_HA_ENTITY_HOUSE_LOAD="sensor.foxess_house_load"
VITE_HA_ENTITY_INDOOR_TEMP="sensor.indoor_t_h_sensor_temperature"
VITE_HA_ENTITY_OUTDOOR_TEMP="sensor.outdoor_t_h_sensor_temperature"

# Screensaver General Settings
VITE_FONT_STYLE="modern"
VITE_WEATHER_SOURCE="open-meteo"
VITE_USE_AUTO_LOCATION="true"
VITE_LATITUDE="-32.8688"
VITE_LONGITUDE="150.2093"
VITE_MANUAL_LOCATION_NAME="Configured Location"
VITE_NIGHT_MODE="auto"
VITE_NIGHT_MODE_DIM_LEVEL="30"
VITE_MOTION_SENSING_ENABLED="false"
VITE_MOTION_SENSITIVITY="20"
VITE_INACTIVITY_TIMEOUT="10"
VITE_BURN_IN_INTERVAL="30"
VITE_PALETTE_OVERRIDE="auto"
VITE_TEMPERATURE_UNIT="C"
VITE_SHOW_SECONDS="true"
VITE_SCREENSAVER_CONTENT_SCALE="0.5"

# Home Assistant Simulation Settings (if HA is disabled)
VITE_SIM_BATTERY_SOC="78"
VITE_SIM_SOLAR_TODAY="12.4"
VITE_SIM_HOUSE_LOAD="0.85"
VITE_SIM_INDOOR_TEMP="22.5"
VITE_SIM_OUTDOOR_TEMP="18.2"

# SFTP Deployment Settings (npm run deploy)
SFTP_HOST=""
SFTP_PORT="22"
SFTP_USER=""
SFTP_PASSWORD=""
# SFTP_KEY_PATH="C:/path/to/private_key"
SFTP_REMOTE_PATH="/var/www/html/haura"